# Application environment: development | test | production
APP_ENV=development

# Database connection string.
# SQLite (Phase 1): sqlite:///./cash_tracker.db
# PostgreSQL (Phase 2+): postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./cash_tracker.db

# Enable verbose SQL logging and debug behavior.
DEBUG=False

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
